{
  "manifest_version": 3,
  "name": "Better Outlook Zoom",
  "version": "0.1.0",
  "description": "Smooth, pointer-centered pinch zoom for Outlook on the web messages.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://outlook.office.com/*",
    "https://outlook.cloud.microsoft/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Better Outlook Zoom"
  },
  "content_scripts": [
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.cloud.microsoft/*"
      ],
      "css": ["outlook.css"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
